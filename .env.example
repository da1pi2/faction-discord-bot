# Token del bot, da Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=il_tuo_token_qui

# Client ID dell'applicazione (Developer Portal -> General Information)
CLIENT_ID=il_tuo_client_id_qui

# ID del server Discord dell'alleanza (tasto destro sul server -> Copia ID,
# serve avere la modalita sviluppatore attiva nelle impostazioni Discord)
GUILD_ID=id_del_tuo_server_qui

# OpenRouter API key per i riassunti AI
OPENROUTER_API_KEY=la_tua_openrouter_key_qui

# Modello OpenRouter opzionale. Default: google/gemma-3-27b-it:free
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# Header opzionali richiesti/dati telemetrici per OpenRouter
OPENROUTER_SITE_URL=https://tuo-dominio-o-localhost
OPENROUTER_APP_NAME=Alliance Activity Bot
